{
  "name": "botcube-config",
  "private": true,
  "type": "module",
  "bin": {
    "botcube": "./cli.ts"
  },
  "exports": {
    "./table-actions": {"types": "./table-actions.d.cts", "default": "./table-actions.cjs"},
    "./session-api-capacity": {"types": "./session-api-capacity.d.cts", "default": "./session-api-capacity.cjs"},
    ".": "./schema.ts",
    "./lambda-inline-grants": {
      "require": {
        "types": "./lambda-inline-grants.d.cts",
        "default": "./lambda-inline-grants.ts"
      },
      "default": "./lambda-inline-grants.ts"
    },
    "./alarm-events": {
      "types": "./alarm-events.d.cts",
      "default": "./alarm-events.cjs"
    },
    "./harness-alarm-events": {
      "types": "./harness-alarm-events.d.cts",
      "default": "./harness-alarm-events.cjs"
    },
    "./blocks": "./blocks.ts",
    "./cli": "./cli.ts",
    "./config-bucket": "./config-bucket.cjs",
    "./existing": "./existing.ts",
    "./images": "./images.ts",
    "./names": {"types": "./names.d.cts", "default": "./names.cjs"},
    "./user-pool": "./user-pool.ts",
    "./renamed-keys": "./renamed-keys.ts",
    "./ecr": {
      "types": "./ecr.d.cts",
      "default": "./ecr.cjs"
    },
    "./deployment": "./deployment.ts",
    "./credential-fields": "./credential-fields.ts",
    "./proxied-fields": "./proxied-fields.ts",
    "./load": "./load.ts",
    "./parse": "./parse.ts",
    "./resolved": "./resolved.ts",
    "./footprint": "./footprint.ts",
    "./models": "./models.ts",
    "./seams": "./seams.d.ts",
    "./environment": "./environment.ts",
    "./telemetry": "./telemetry.ts",
    "./read": {
      "types": "./read.d.cts",
      "default": "./read.cjs"
    }
  },
  "scripts": {
    "emit": "node emit.ts",
    "footprint": "node cli.ts footprint"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
