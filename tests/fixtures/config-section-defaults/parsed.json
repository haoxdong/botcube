{
  "allowCommandCredentials": true,
  "schedules": {
    "kind": "eventbridge-scheduler"
  },
  "liveView": {
    "kind": "agentcore-browser"
  },
  "integrations": {
    "signIn": {
      "kind": "botcube-accounts"
    },
    "modelGateway": {
      "kind": "bedrock"
    },
    "harnessAuth": {
      "kind": "sigv4"
    },
    "awsAccess": {
      "kind": "web-identity"
    },
    "telemetry": {
      "kind": "otlp",
      "url": "http://collector:4318/v1/traces",
      "credential": {
        "kind": "command",
        "command": ["/usr/local/bin/telemetry-token"],
        "timeoutSeconds": 30
      }
    },
    "imageRegistry": "public.ecr.aws"
  },
  "network": {
    "proxy": {
      "kind": "forward",
      "url": "http://proxy.example.com:3128"
    }
  }
}
