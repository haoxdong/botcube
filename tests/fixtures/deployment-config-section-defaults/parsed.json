{
  "bot": "./bot.json",
  "allowCommandCredentials": true,
  "identity": { "kind": "botcube-accounts" },
  "models": { "kind": "bedrock" },
  "harnessAuth": { "kind": "sigv4" },
  "turnCredentials": { "kind": "web-identity" },
  "schedules": { "kind": "eventbridge-scheduler" },
  "liveView": { "kind": "agentcore-browser" },
  "imageRegistry": "public.ecr.aws",
  "proxy": {
    "kind": "forward",
    "url": "http://proxy.example.com:3128"
  },
  "telemetry": {
    "kind": "otlp",
    "url": "http://collector:4318/v1/traces",
    "credential": {
      "kind": "command",
      "command": ["/usr/local/bin/telemetry-token"],
      "timeoutSeconds": 30
    }
  }
}
