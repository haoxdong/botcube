    "botcube-artifact-check": "workspace:*",
    "botcube-config": "workspace:*",
    "croner": "^10.0.1",
    "eventsource-parser": "3.1.1",
    "fast-json-patch": "3.1.1",
    "hono": "^4.13.17",
    "jose": "6.2.14",
    "openid-client": "6.8.8",
    "p-limit": "^7.3.3",
