#!/usr/bin/env python3
"""The fake site's CLI: reads the fake site data through the Credential Service binding fake_site_harness.py hands the shell.

Standard library only, so any `python3` on the agent's PATH runs it.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


def main() -> None:
    parser = argparse.ArgumentParser(description='Read the fake site data.')
    parser.add_argument('command', choices=['data'])
    parser.parse_args()
    url = os.environ.get('FAKE_SITE_CREDENTIAL_SERVICE_URL')
    invocation = os.environ.get('FAKE_SITE_CREDENTIAL_INVOCATION')
    session = os.environ.get('FAKE_SITE_CREDENTIAL_SESSION')
    if not url or not invocation or not session:
        parser.exit(1, 'Fake site sign-in needed. Credential Service invocation is required.\n')
    request = Request(f'{url.rstrip("/")}/fake-site/data', headers={'Authorization': f'Bearer {invocation}', 'X-BotCube-Session-Id': session})
    try:
        with urlopen(request, timeout=10) as response:
            data = json.load(response)
    except HTTPError as error:
        parser.exit(1, 'Fake site sign-in needed.\n' if error.code == 401 else f'Fake site HTTP {error.code}.\n')
    except (URLError, OSError, ValueError) as error:
        parser.exit(1, f'Fake site request failed: {error}.\n')
    sys.stdout.write(json.dumps(data) + '\n')


if __name__ == '__main__':
    main()
